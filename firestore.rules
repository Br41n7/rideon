rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Check if user is signed in and has admin role
      return isSignedIn() && (
        request.auth.token.email == 'iyanuolalegan@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      // For mock users (anonymous), we don't have email_verified in the token
      return request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn(); // Allow creation if signed in (anonymous or other)
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }

    // Driver Rules
    match /drivers/{userId} {
      allow read: if true; // Allow anyone to see available drivers for the demo
      allow write: if isAdmin() || isOwner(userId);
    }

    // Ride Rules
    match /rides/{rideId} {
      allow create: if isSignedIn(); 
      allow get: if true; // Relax for demo
      allow list: if true; // Relax for demo to allow drivers to see pending rides without complex filter satisfaction in rules
      allow update: if isSignedIn(); // Relax for demo
      allow delete: if isAdmin();
    }
  }
}
