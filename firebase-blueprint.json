{
  "entities": {
    "User": {
      "title": "User",
      "description": "Information about a student rider, driver, or admin.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["rider", "driver", "admin"] },
        "verified": { "type": "boolean" },
        "rating": { "type": "number" },
        "totalRatings": { "type": "number" },
        "safetyReportsCount": { "type": "number" },
        "studentIdUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role", "verified"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Driver-specific information and availability.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "vehicleInfo": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "rating": { "type": "number" },
        "totalTrips": { "type": "number" },
        "currentLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "vehicleInfo", "isAvailable"]
    },
    "Ride": {
      "title": "Ride",
      "description": "A ride request and trip information.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "riderId": { "type": "string" },
        "riderName": { "type": "string" },
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "pickupLocation": {
          "type": "object",
          "properties": {
            "address": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "destination": {
          "type": "object",
          "properties": {
            "address": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "status": { "type": "string", "enum": ["pending", "accepted", "ongoing", "completed", "cancelled"] },
        "fare": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "wallet"] },
        "riderRating": { "type": "number" },
        "riderReview": { "type": "string" },
        "riderTags": { "type": "array", "items": { "type": "string" } },
        "riderReportedSafety": { "type": "boolean" },
        "riderReviewedAt": { "type": "string", "format": "date-time" },
        "driverRating": { "type": "number" },
        "driverReview": { "type": "string" },
        "driverTags": { "type": "array", "items": { "type": "string" } },
        "driverReportedSafety": { "type": "boolean" },
        "driverReviewedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["riderId", "pickupLocation", "destination", "status", "fare", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Post-ride rating, feedback tags, and safety report for riders and drivers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rideId": { "type": "string" },
        "reviewerId": { "type": "string" },
        "reviewerName": { "type": "string" },
        "reviewerRole": { "type": "string", "enum": ["rider", "driver"] },
        "targetUserId": { "type": "string" },
        "targetUserName": { "type": "string" },
        "rating": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "comment": { "type": "string" },
        "isSafetyReport": { "type": "boolean" },
        "safetyCategory": { "type": "string" },
        "safetyDetails": { "type": "string" },
        "safetyStatus": { "type": "string", "enum": ["open", "investigating", "resolved"] },
        "pickupAddress": { "type": "string" },
        "destinationAddress": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["rideId", "reviewerId", "reviewerRole", "targetUserId", "rating", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/drivers/{userId}": {
      "schema": "Driver",
      "description": "Driver-specific status and location"
    },
    "/rides/{rideId}": {
      "schema": "Ride",
      "description": "Ride trips"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Post-ride rating and safety reviews"
    }
  }
}
